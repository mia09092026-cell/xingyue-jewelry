# Analytics deployment template for Vercel environment variables.
# For the full local template, including inquiry storage, use .env.local.example.
# These placeholders are intentionally invalid and keep both providers disabled.
#
# Vercel environment matrix:
# - Production: use the real GA and Clarity public IDs; keep QA false or omit it.
# - Preview: analytics is off by default. Temporary QA needs valid IDs and QA=true.
# - Development: analytics is off by default. Local QA needs valid IDs and QA=true.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACE_ME
NEXT_PUBLIC_CLARITY_PROJECT_ID=replace_me
NEXT_PUBLIC_ANALYTICS_QA_ENABLED=false
