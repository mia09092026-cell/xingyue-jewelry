# Public analytics configuration.
# Replace these placeholders only in the deployment environment that should
# collect analytics. Leaving either ID empty disables that provider.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Analytics QA is disabled by default. Keep this false (or omit it) unless a
# temporary Preview or Development analytics verification explicitly needs it.
NEXT_PUBLIC_ANALYTICS_QA_ENABLED=false
