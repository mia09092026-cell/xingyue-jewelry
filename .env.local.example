# Google Sheets inquiry storage for Vercel / local testing.
# Do not commit real service account JSON, private keys, passwords, or API keys.

# Service account email from Google Cloud IAM.
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private key. In Vercel, paste the key with escaped newlines (\n).
# The app converts \n back to real line breaks at runtime.
GOOGLE_SHEETS_PRIVATE_KEY=

# The target Google Spreadsheet ID, from the spreadsheet URL.
GOOGLE_SHEETS_SPREADSHEET_ID=

# The worksheet/tab name that should receive inquiries, for example: Inquiries
GOOGLE_SHEETS_SHEET_NAME=
