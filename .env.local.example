# Full local environment template for inquiry storage and analytics.
# For an analytics-only Vercel deployment template, use .env.example.
# Google Sheets inquiry storage for Vercel / local testing.
# Do not commit real service account JSON, private keys, passwords, or API keys.

# Service account email from Google Cloud IAM.
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private key. In Vercel, paste the key with escaped newlines (\n).
# The app converts \n back to real line breaks at runtime.
GOOGLE_SHEETS_PRIVATE_KEY=

# The target Google Spreadsheet ID, from the spreadsheet URL.
GOOGLE_SHEETS_SPREADSHEET_ID=

# The worksheet/tab name that should receive inquiries, for example: Inquiries
GOOGLE_SHEETS_SHEET_NAME=

# Optional: only needed if you want to run the protected test-write endpoint on Vercel.
# Keep this private and send it as the x-inquiry-test-token request header.
INQUIRY_TEST_TOKEN=

# Public analytics configuration. These placeholders are intentionally invalid
# and keep both providers disabled.
#
# Vercel environment matrix:
# - Production: use the real GA and Clarity public IDs; keep QA false or omit it.
# - Preview: analytics is off by default. Temporary QA needs valid IDs and QA=true.
# - Development: analytics is off by default. Local QA needs valid IDs and QA=true.
#
# GA4 Data Stream > Enhanced Measurement operator checklist:
# - Keep Page views enabled.
# - Keep browser-history page changes enabled.
# - Turn OFF Outbound clicks.
# - Turn OFF File downloads.
# - Turn OFF Form interactions.
# - In Tag Assistant, verify one interaction creates one intended custom event.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACE_ME
NEXT_PUBLIC_CLARITY_PROJECT_ID=replace_me
NEXT_PUBLIC_ANALYTICS_QA_ENABLED=false
